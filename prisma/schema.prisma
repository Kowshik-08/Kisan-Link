// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum Language {
  EN
  TE
  HI
}

enum BuyerType {
  MANDI
  FPO
  PRIVATE
}

enum Unit {
  KG
  QUINTAL
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
}

enum DealStage {
  OFFER_SENT
  BUYER_ACCEPTED
  DEAL_CONFIRMED
  DISPATCHED
  DELIVERED
  PAID
  COMPLETED_RATED
}

enum PaymentStatus {
  PENDING
  ESCROWED
  RELEASED
  REFUNDED
}

// ==========================================
// 1. USERS
// ==========================================
model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String?   @unique @db.VarChar(15) // 10-digit mobile number for Farmers & Buyers
  adminCode         String?   @unique @map("admin_code") @db.VarChar(50) // Admin identifier
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  fullName          String    @map("full_name") @db.VarChar(100)
  role              Role      @default(FARMER)
  preferredLanguage Language  @default(EN) @map("preferred_language")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // 1-to-1 Role Profile Relations
  farmer            Farmer?
  buyer             Buyer?

  // Cart & Address Relations
  cart              Cart?
  addresses         Address[]

  // Reviews Relations
  reviewsGiven      Review[]  @relation("ReviewsGiven")
  reviewsReceived   Review[]  @relation("ReviewsReceived")

  @@index([role])
  @@index([phone])
  @@map("users")
}

// ==========================================
// 2. FARMERS (Farmer Profiles)
// ==========================================
model Farmer {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  village           String    @db.VarChar(100) // Village / Local area (e.g. Narsampet, ReddyPalem)
  mandal            String?   @db.VarChar(100)
  district          String    @db.VarChar(100) // Warangal, Karimnagar, Nalgonda, Khammam, Adilabad
  state             String    @default("Telangana") @db.VarChar(100)
  landSizeAcres     Decimal?  @map("land_size_acres") @db.Decimal(5, 2)
  upiId             String?   @map("upi_id") @db.VarChar(50) // Payout UPI ID
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(30)
  bankIfsc          String?   @map("bank_ifsc") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]   @relation("FarmerOrders")

  @@index([district])
  @@index([village])
  @@map("farmers")
}

// ==========================================
// 3. BUYERS (Buyer Profiles)
// ==========================================
model Buyer {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  businessName      String    @map("business_name") @db.VarChar(150) // e.g. Warangal APMC Market, Sahyadri Farmers FPO
  buyerType         BuyerType @map("buyer_type") // MANDI, FPO, PRIVATE
  commissionRate    Decimal   @default(0.02) @map("commission_rate") @db.Decimal(5, 4) // e.g. 0.06 (6%), 0.03 (3%), 0.02 (2%)
  priceMultiplier   Decimal   @default(1.00) @map("price_multiplier") @db.Decimal(5, 4) // e.g. 1.05 (FPO), 1.10 (Lasalgaon), 0.94 (Traders)
  baseDistanceKm    Int       @default(10) @map("base_distance_km") // Baseline distance in km
  isVerified        Boolean   @default(false) @map("is_verified") // 🟢 Verified badge vs Unverified
  ratingAverage     Decimal   @default(0.0) @map("rating_average") @db.Decimal(3, 2) // e.g. 4.8, 4.6, 3.6
  totalDealsCount   Int       @default(0) @map("total_deals_count") // e.g. 340, 212 deals
  licenseNumber     String?   @map("license_number") @db.VarChar(100)
  gstNumber         String?   @map("gst_number") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]   @relation("BuyerOrders")

  @@index([buyerType])
  @@index([isVerified])
  @@map("buyers")
}

// ==========================================
// 4. CATEGORIES
// ==========================================
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100) // e.g. Perishable Vegetables, Oilseeds, Commercial Crops, Food Grains
  slug        String    @unique @db.VarChar(100) // e.g. vegetables, oilseeds, commercial, grains
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  products    Product[]

  @@map("categories")
}

// ==========================================
// 5. PRODUCTS (Crops / Agricultural Commodities)
// ==========================================
model Product {
  id            String      @id @default(uuid()) @db.Uuid
  categoryId    String      @map("category_id") @db.Uuid
  name          String      @db.VarChar(100) // Tomato, Onion, Soybean, Cotton, Wheat
  slug          String      @unique @db.VarChar(100) // tomato, onion, soybean, cotton, wheat
  nameTe        String?     @map("name_te") @db.VarChar(100) // Telugu: టమాటా, ఉల్లిపాయ, సోయాబీన్, పత్తి, గోధుమ
  nameHi        String?     @map("name_hi") @db.VarChar(100) // Hindi: टमाटर, प्याज़, सोयाबीन, कपास, गेहूं
  icon          String      @db.VarChar(10) // 🍅, 🧅, 🌱, 🌾, 🌿
  basePrice     Decimal     @map("base_price") @db.Decimal(10, 2) // Benchmark ₹/kg: 18, 14, 44, 62, 24
  standardUnit  Unit        @default(KG) @map("standard_unit")
  priceTrend    Decimal[]   @map("price_trend") @db.Decimal(10, 2) // 7-day trend array: [14, 15, 15, 17, 16, 18, 18]
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// 6. CART
// ==========================================
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid // 1-to-1 active trade lot basket per User
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

// ==========================================
// 7. CART ITEMS
// ==========================================
model CartItem {
  id              String       @id @default(uuid()) @db.Uuid
  cartId          String       @map("cart_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  quantity        Decimal      @db.Decimal(10, 2) // e.g. 500
  unit            Unit         @default(KG)
  qualityGrade    QualityGrade @default(GRADE_A) @map("quality_grade") // GRADE_A (1.0), GRADE_B (0.88), GRADE_C (0.74)
  targetPricePerKg Decimal?    @map("target_price_per_kg") @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  cart            Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, qualityGrade])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ==========================================
// 8. ORDERS (Deals / Transactions)
// ==========================================
model Order {
  id                String        @id @default(uuid()) @db.Uuid
  orderNumber       String        @unique @map("order_number") @db.VarChar(30) // Human-readable e.g. KL-2026-9041
  farmerId          String        @map("farmer_id") @db.Uuid
  buyerId           String        @map("buyer_id") @db.Uuid
  dealStage         DealStage     @default(OFFER_SENT) @map("deal_stage") // 7-step transaction flow
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  distanceKm        Int           @map("distance_km") // Calculated distance from origin to buyer hub
  grossAmount       Decimal       @map("gross_amount") @db.Decimal(12, 2) // pricePerKg * quantityKg
  transportCost     Decimal       @map("transport_cost") @db.Decimal(10, 2) // distanceKm * 2.1 * (qtyKg / 100)
  marketFee         Decimal       @map("market_fee") @db.Decimal(10, 2) // grossAmount * commissionRate
  handlingCost      Decimal       @map("handling_cost") @db.Decimal(10, 2) // 40 + (qtyKg * 0.06)
  netAmount         Decimal       @map("net_amount") @db.Decimal(12, 2) // gross - transport - fee - handling
  pickupAddressId   String?       @map("pickup_address_id") @db.Uuid
  deliveryAddressId String?       @map("delivery_address_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  farmer            Farmer        @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  buyer             Buyer         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  pickupAddress     Address?      @relation("OrderPickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddress   Address?      @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])
  review            Review?

  @@index([farmerId])
  @@index([buyerId])
  @@index([dealStage])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// ==========================================
// 9. ORDER ITEMS
// ==========================================
model OrderItem {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  quantity     Decimal      @db.Decimal(10, 2)
  unit         Unit         @default(KG)
  quantityInKg Decimal      @map("quantity_in_kg") @db.Decimal(10, 2) // Standardized kg amount
  qualityGrade QualityGrade @default(GRADE_A) @map("quality_grade")
  pricePerKg   Decimal      @map("price_per_kg") @db.Decimal(10, 2) // Net unit price offered
  totalPrice   Decimal      @map("total_price") @db.Decimal(12, 2) // Gross line item price
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  // Relationships
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==========================================
// 10. ADDRESSES
// ==========================================
model Address {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String?   @db.VarChar(100) // e.g. "Main Farm", "APMC Yard Gate 1"
  street         String?   @db.VarChar(255)
  village        String?   @db.VarChar(100) // Narsampet, ReddyPalem, Kopargaon, etc.
  mandal         String?   @db.VarChar(100)
  district       String    @db.VarChar(100) // Warangal, Karimnagar, Nalgonda, Khammam, Adilabad
  state          String    @default("Telangana") @db.VarChar(100)
  pincode        String?   @db.VarChar(10)
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  isDefault      Boolean   @default(false) @map("is_default")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupOrders   Order[]   @relation("OrderPickupAddress")
  deliveryOrders Order[]   @relation("OrderDeliveryAddress")

  @@index([userId])
  @@index([district])
  @@map("addresses")
}

// ==========================================
// 11. REVIEWS
// ==========================================
model Review {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid // 1-to-1 review on deal completion (Stage 7: "Rate buyer")
  reviewerId  String    @map("reviewer_id") @db.Uuid
  revieweeId  String    @map("reviewee_id") @db.Uuid
  rating      Int       // 1 to 5 stars
  comment     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relationships
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer    User      @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User      @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([revieweeId])
  @@index([rating])
  @@map("reviews")
}
