# ====================================================================
# KisanLink Production Environment Variables Template
# ====================================================================
# Copy this file to .env in production and fill in your real credentials:
# cp .env.example .env

# Server Runtime
NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection String (Prisma)
# Example (Neon.tech / Supabase / Render / AWS RDS):
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL="postgresql://kisanlink_user:your_secure_db_password@localhost:5432/kisanlink?schema=public"

# JSON Web Token (JWT) Security Keys (Generate via: openssl rand -base64 48)
JWT_SECRET="replace-with-a-very-long-random-string-min-32-characters"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-another-distinct-random-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Origin for CORS Whitelisting
# Set to your deployed Vercel domain or custom domain (comma-separated for multiple)
FRONTEND_URL="https://kisanlink-drab.vercel.app"
CLIENT_URL="https://kisanlink-drab.vercel.app"
